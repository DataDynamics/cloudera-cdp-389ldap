# ---------------------------------------------------------------------------
# 03-aci.ldif
#   접근 제어(ACI) 설정
#     1) cdpbind : People/Groups 읽기 전용
#     2) cdpadmin: People/Groups 관리(추가/수정/삭제) — scripts/ldap-*.sh 용
#     3) 사용자 본인: 자신의 패스워드 변경 허용
#     4) (선택) 익명 읽기 허용 ACI 제거
#   적용:
#     ldapmodify -H ldaps://ldap01.example.com:636 -x \
#       -D "cn=Directory Manager" -W -f ldif/03-aci.ldif
#
#   현재 ACI 확인:
#     ldapsearch -H ldaps://... -x -D "cn=Directory Manager" -W \
#       -b "dc=example,dc=com" -s base aci
# ---------------------------------------------------------------------------

# 1) 읽기 전용 바인드 계정 (CM / Ranger Usersync / Hue / SSSD / Knox 등이 사용)
dn: ou=People,dc=example,dc=com
changetype: modify
add: aci
aci: (targetattr="objectClass || uid || cn || sn || givenName || mail || uidNumber || gidNumber || homeDirectory || loginShell || gecos || nsAccountLock")(version 3.0; acl "cdpbind read people"; allow (read, search, compare) userdn="ldap:///uid=cdpbind,ou=Services,dc=example,dc=com";)

dn: ou=Groups,dc=example,dc=com
changetype: modify
add: aci
aci: (targetattr="objectClass || cn || gidNumber || memberUid || description")(version 3.0; acl "cdpbind read groups"; allow (read, search, compare) userdn="ldap:///uid=cdpbind,ou=Services,dc=example,dc=com";)

# 2) 사용자/그룹 관리 계정
dn: ou=People,dc=example,dc=com
changetype: modify
add: aci
aci: (targetattr="*")(version 3.0; acl "cdpadmin manage people"; allow (all) userdn="ldap:///uid=cdpadmin,ou=Services,dc=example,dc=com";)

dn: ou=Groups,dc=example,dc=com
changetype: modify
add: aci
aci: (targetattr="*")(version 3.0; acl "cdpadmin manage groups"; allow (all) userdn="ldap:///uid=cdpadmin,ou=Services,dc=example,dc=com";)

# 3) 본인 패스워드 변경 허용 (ldap-change-password.sh --self)
dn: ou=People,dc=example,dc=com
changetype: modify
add: aci
aci: (targetattr="userPassword")(version 3.0; acl "self password change"; allow (write) userdn="ldap:///self";)

# 4) (선택) 익명 읽기 허용 ACI 제거
#    - 위 ldapsearch 로 조회한 값과 "완전히 동일한 문자열"이어야 삭제된다.
#    - 제거 전에 1)~3) 이 정상 동작하는지 반드시 먼저 확인하십시오.
#dn: dc=example,dc=com
#changetype: modify
#delete: aci
#aci: (targetattr!="userPassword || aci")(version 3.0; acl "Enable anonymous access"; allow (read, search, compare) userdn="ldap:///anyone";)
