# ---------------------------------------------------------------------------
# 02-service-accounts.ldif
#   CDP 컴포넌트가 사용할 바인드 계정
#     - uid=cdpbind  : 읽기 전용 (CM / Ranger Usersync / Hue / SSSD / Knox 등)
#     - uid=cdpadmin : 사용자·그룹 관리용 (스크립트에서 사용, 03-aci.ldif 로 권한 부여)
#   적용:
#     ldapmodify -H ldaps://... -x -D "cn=Directory Manager" -W -a -f ldif/02-service-accounts.ldif
#   적용 후 반드시 패스워드를 설정하십시오:
#     ldappasswd -H ldaps://... -x -D "cn=Directory Manager" -W -S \
#       "uid=cdpbind,ou=Services,dc=example,dc=com"
# ---------------------------------------------------------------------------

dn: uid=cdpbind,ou=Services,dc=example,dc=com
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
uid: cdpbind
cn: CDP Bind Account
sn: cdpbind
description: Read-only bind account for Cloudera CDP components

dn: uid=cdpadmin,ou=Services,dc=example,dc=com
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
uid: cdpadmin
cn: CDP User Management Account
sn: cdpadmin
description: Account used by scripts/ldap-*.sh for user provisioning
