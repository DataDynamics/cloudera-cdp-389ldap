# 389 Directory Server 설정 파일 (실제 값으로 수정 후 `ldap.env` 로 복사)
#   cp ldap.env.example ldap.env && chmod 600 ldap.env
# 환경변수로 직접 지정하거나, LDAP_ENV_FILE=/path/to/file 로 다른 경로를 사용할 수 있습니다.

# ── 접속 정보 ────────────────────────────────────────────────────────────────
# 운영 환경에서는 반드시 ldaps(636) 또는 STARTTLS 를 사용하십시오.
LDAP_URI="ldaps://ldap01.example.com:636"

# 디렉터리 루트 서픽스
LDAP_BASE_DN="dc=example,dc=com"

# 사용자/그룹 관리 권한을 가진 바인드 DN
#  - 초기 구축 시: cn=Directory Manager
#  - 운영 권장:    uid=cdpadmin,ou=Services,dc=example,dc=com (ACI 로 People/Groups 쓰기 권한 부여)
LDAP_BIND_DN="cn=Directory Manager"

# 바인드 패스워드는 아래 둘 중 하나만 사용 (파일 방식 권장, 개행 없이 저장)
#   printf '%s' 'SecretPassw0rd' > /etc/dirsrv/.cdpadmin.pw && chmod 600 /etc/dirsrv/.cdpadmin.pw
LDAP_BIND_PW_FILE=""
LDAP_BIND_PW=""
# 둘 다 비워두면 실행 시 터미널에서 입력받습니다.

# ── TLS ─────────────────────────────────────────────────────────────────────
# 서버 인증서를 검증할 CA 인증서 경로
LDAP_TLS_CACERT="/etc/pki/ca-trust/source/anchors/389ds-ca.pem"
# never | allow | try | demand  (운영 환경은 demand 유지)
LDAP_TLS_REQCERT="demand"

# ── 디렉터리 구조 ────────────────────────────────────────────────────────────
LDAP_USER_BASE="ou=People,dc=example,dc=com"
LDAP_GROUP_BASE="ou=Groups,dc=example,dc=com"

# ── 계정 기본값 ──────────────────────────────────────────────────────────────
# 기본 1차 그룹 (없으면 자동 생성)
LDAP_DEFAULT_GROUP="cdpusers"

# uidNumber / gidNumber 자동 할당 시작값 (OS 로컬 계정과 겹치지 않게 충분히 크게)
LDAP_UID_MIN="20000"
LDAP_GID_MIN="20000"

# 홈 디렉터리 상위 경로 → /home/<uid>
LDAP_HOME_BASE="/home"
LDAP_SHELL="/bin/bash"

# 자동 생성 패스워드 길이 (--random 사용 시)
LDAP_RANDOM_PW_LEN="16"
